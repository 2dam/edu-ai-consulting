# ─────────────────────────────────────────────────────────────
# Google AdSense 설정 (EduIntel 커뮤니티 / doke-v.net)
# 실제 값은 AdSense 가입 후 받은 게시자 ID로 채웁니다.
# ─────────────────────────────────────────────────────────────

# AdSense 게시자 ID (형식: pub-XXXXXXXXXXXXXXXX). 플레이스홀더는 광고를 로드하지 않음.
VITE_ADSENSE_PUBLISHER_ID=pub-0000000000000000

# 사이트 도메인
VITE_SITE_DOMAIN=doke-v.net

# 동의 후 광고 활성화 여부 (true 기본)
VITE_ADS_ENABLED=true

# 광고단위 슬롯 ID (AdSense → 광고 → 광고단위에서 복사. 자동 광고는 비워둬도 됨)
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_FEED=
VITE_AD_SLOT_SIDEBAR=
