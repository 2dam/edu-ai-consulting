# ─────────────────────────────────────────────────────────────
# Google AdSense 설정 (EduIntel / doke-v.net)
# 실제 값은 AdSense 가입 후 받은 게시자 ID로 채웁니다.
# 로컬/CI 에는 절대 실제 ID를 커밋하지 마세요(.env.local 사용).
# ─────────────────────────────────────────────────────────────

# AdSense 게시자 ID (AdSense → 좌측 메뉴 '내 계정' → '게시자 ID')
# 형식: pub-XXXXXXXXXXXXXXXX (16자리 숫자). 아래는 예시 플레이스홀더.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=pub-0000000000000000

# 사이트 도메인 (ads.txt, CORS, 메타태그 확인용). 실제 운영 도메인.
NEXT_PUBLIC_SITE_DOMAIN=doke-v.net

# 쿠키/개인정보 동의 후 광고를 활성화할지 여부.
# true → 방문자가 '동의'하기 전까지 광고 스크립트를 로드하지 않음 (GDPR/개인정보보호법 대응).
NEXT_PUBLIC_ADS_ENABLED=true
