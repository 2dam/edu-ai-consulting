OPENAI_API_KEY=sk-...
DATABASE_URL=sqlite:///./edu_consulting.db

# OAuth2/JWT 인증. 운영 환경에서는 32자 이상의 무작위 값으로 설정하고 외부에 공개하지 마세요.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=60
# 최초 관리자 계정(id=1)에 비밀번호 해시가 없을 때만 설정됩니다. 설정 후 환경변수에서 제거하세요.
ADMIN_PASSWORD=

# EduIntelligence Panel — 30인 교육컨설팅 위원회 (Claude API, https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=

# 전국 공공 도로 CCTV (국가교통정보센터 ITS, https://openapi.its.go.kr 무료 발급)
ITS_API_KEY=

# 나이스(NEIS) 교육정보 개방포털 — 초등학교 기초현황 (https://open.neis.go.kr 무료 발급)
NEIS_API_KEY=

# 공공데이터포털(data.go.kr) 서비스키 — 어린이집/유치원 기초현황 활용신청 후 발급
DATA_GO_KR_SERVICE_KEY=

# 실시간 교육 동영상 패널 — YouTube Data API v3 (https://console.cloud.google.com 에서
# "YouTube Data API v3" 활성화 후 API 키 발급, 무료 할당량 하루 10,000유닛)
YOUTUBE_API_KEY=

# 여론 평가(뉴스/댓글 감정분석) — Hugging Face 모델명, 기본값 ProsusAI/finbert.
# transformers/torch 미설치 시 규칙 기반 감정분석으로 자동 폴백 (api/requirements.txt 참고).
FINBERT_MODEL_NAME=
